<div class="drawer-side z-20">
  <label for="drawer" aria-label="close sidebar" class="drawer-overlay"></label>
  <aside class="px-5 py-16 h-screen w-80 max-w-screen overflow-auto bg-base-100 bg-opacity-90 backdrop-blur border-r border-white/5 shadow-md">
    <nav tabindex="0" class="menu">
      <ul>
      <li>
        <header class="menu-title">Redbrick</header>
        <ul>
        {% for entry in site.navigation.global %}
        {% if entry.submenu %}
        <li>
          <details>
            <summary>{{ entry.text }}</summary>
            <ul>
              {% if entry.link %}<li><a href="{{ entry.link }}">Overview</a></li>{% endif %}
              {% for sub in entry.submenu %}
              <li><a href="{{ sub.link }}">{{ sub.text }}</a></li>
              {% endfor %}
            </ul>
          </details>
        </li>
        {% else %}
        <li><a href="{{ entry.link }}">{{ entry.text }}</a></li>
        {% endif %}
        {% endfor %}
        </ul>
      </li>
      </ul>
      {% if page.url and "/open-governance/" in page.url %}
      <header class="menu-title">Open Governance</header>
      {{ collections['open-governance'] | eleventyNavigation | renderTree | safe }}
      {% elif page.url and "/blog/" in page.url %}
      <header class="menu-title">Blog</header>
      {{ collections['blog'] | eleventyNavigation | renderTree | safe }}
      {% elif page.url and "/services/" in page.url %}
      <header class="menu-title">Services</header>
      {{ collections['services'] | eleventyNavigation | renderTree | safe }}
      {% endif %}
    </nav>
  </aside>
</div>
