          <image href="{{ site.images.brick.src }}" x="230" y="145" width="135" height="108" filter="url(#services-logo-shadow)"/>
        </svg>
      </div>
    </div>
  </header>

  <section id="catalogue" class="mx-auto max-w-7xl px-5 py-10 md:px-10 lg:py-14" aria-labelledby="services-heading">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 id="services-heading" class="text-3xl font-bold">Our services</h2>
        <p class="mt-2 text-base-content/75">Find a service and see how to access it.</p>
      </div>
      <a class="link text-sm" href="https://status.redbrick.dcu.ie/">Check service status ↗</a>
    </div>
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {% for service in services %}
      <article class="services-card flex min-w-0 flex-col rounded-xl border border-base-content/20 bg-base-100 p-6 shadow-sm">
        <div class="mb-4 flex items-center gap-3">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">{{ icon(service.icon) }}</span>
          <h3 class="text-xl font-bold">{{ service.name }}</h3>
        </div>
        <p class="leading-relaxed">{{ service.description }}</p>
        <p class="services-access mb-6 mt-3 text-sm leading-relaxed text-base-content/75"><strong class="font-semibold">Access:</strong> {{ service.access }}</p>
        <a class="mt-auto inline-flex items-center justify-between gap-3 border-t border-base-content/10 pt-4 font-semibold text-primary hover:underline" href="{{ service.link }}">{{ service.action }} <span class="shrink-0">{{ arrow() }}</span></a>
      </article>
      {% endfor %}
      <aside class="flex flex-col justify-center rounded-xl bg-base-200 p-6" aria-labelledby="services-help-heading">
        <h3 id="services-help-heading" class="text-xl font-bold">Need help getting connected?</h3>
        <p class="mt-3 max-w-lg leading-relaxed text-base-content/75">Find setup guides in the documentation, or ask the Systems Administrators on Discord if you need help with your account or a service.</p>
        <div class="mt-5 flex flex-wrap gap-x-6 gap-y-3">
          <a class="link font-semibold" href="https://docs.redbrick.dcu.ie/">Read the documentation ↗</a>
          <a class="link font-semibold" href="{{ site.navigation.buttons.secondary.link }}">Ask on Discord ↗</a>
        </div>
      </aside>
    </div>
  </section>

  <section id="hosting" class="border-t border-base-content/10 bg-base-200" aria-labelledby="requests-heading">
    <div class="mx-auto max-w-7xl px-5 py-10 md:px-10 lg:py-14">
      <div class="mb-6 max-w-2xl">
        <h2 id="requests-heading" class="text-3xl font-bold">Services on request</h2>
        <p class="mt-3 leading-relaxed text-base-content/75">The Systems Administrators arrange access and hosting for these services. Open a ticket on Discord with what you need and any resource requirements. Requests are subject to available resources.</p>
        <p class="mt-3 leading-relaxed text-base-content/75">Redbrick reserves the right to refuse or cease hosting at any time, for any reason.</p>
        {# Add the published hosting guidelines link after https://github.com/redbrick/open-governance/pull/36 is merged. #}
      </div>
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {% for service in requestedServices %}
        <article class="services-card flex min-w-0 flex-col rounded-xl border border-base-content/20 bg-base-100 p-6 shadow-sm">
          <div class="mb-4 flex items-center gap-3">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">{{ icon(service.icon) }}</span>
            <h3 class="text-xl font-bold">{{ service.name }}</h3>
          </div>
          <p class="mb-6 leading-relaxed">{{ service.description }}</p>
          <a class="mt-auto inline-flex items-center justify-between gap-3 border-t border-base-content/10 pt-4 font-semibold text-primary hover:underline" href="{{ site.navigation.buttons.secondary.link }}" aria-label="Request on Discord: {{ service.name }}">Request on Discord <span class="shrink-0">{{ arrow() }}</span></a>
        </article>
        {% endfor %}
        <div class="flex flex-col items-start justify-center p-6 lg:col-span-3">
          <h3 class="text-xl font-bold">Need something else?</h3>
          <p class="mt-3 leading-relaxed text-base-content/75">Talk to the Systems Administrators about what you need.</p>
          <a class="btn btn-neutral mt-5" href="{{ site.navigation.buttons.secondary.link }}">Ask on Discord {{ arrow() }}</a>
        </div>
      </div>
    </div>
  </section>
</main>
