            <path d="m378 139 43-36m30 0 43 36" stroke="oklch(var(--p) / .3)"/>
          </g>

          <g transform="rotate(-5 113 292)" filter="url(#services-paper-shadow)" stroke-linejoin="round">
            <path d="M56 247h84a15 15 0 0 1 15 15v34a15 15 0 0 1-15 15h-48l-24 18v-18H56a15 15 0 0 1-15-15v-34a15 15 0 0 1 15-15Z" fill="oklch(var(--p))"/>
            <path d="M62 268h57m-57 13h39" stroke="oklch(var(--pc) / .9)" stroke-width="3" stroke-linecap="round"/>
            <path d="M116 290h60a13 13 0 0 1 13 13v24a13 13 0 0 1-13 13h-5v16l-23-16h-32a13 13 0 0 1-13-13v-24a13 13 0 0 1 13-13Z" fill="oklch(var(--b1))" stroke="oklch(var(--bc) / .2)"/>
            <g fill="oklch(var(--p))"><circle cx="130" cy="315" r="3"/><circle cx="146" cy="315" r="3"/><circle cx="162" cy="315" r="3"/></g>
          </g>

          <g transform="rotate(6 421 307)" filter="url(#services-paper-shadow)">
            <rect x="320" y="253" width="198" height="117" rx="9" fill="oklch(var(--b1))" stroke="oklch(var(--bc) / .2)"/>
