{% macro arrow() %}
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
{% endmacro %}
{% macro icon(path) %}
<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="{{ path }}" /></svg>
{% endmacro %}

<style>
  /* Match the homepage background while keeping the artwork in its own layout space. */
  #services-page .services-hero { background-image: url(https://cdn.redbrick.dcu.ie/atlas/static/img/spotlight-bg.webp); background-position: top center; background-size: cover; }
  #services-page .services-hero::before { content: ""; position: absolute; inset: 0; pointer-events: none; background: oklch(var(--bc)); mask-image: url(https://cdn.redbrick.dcu.ie/atlas/static/svg/grid-bg.svg); }
  #services-page .services-art { width: 100%; max-width: 480px; }
  #services-page .services-card { transition: border-color .2s, box-shadow .2s; }
  #services-page .services-card:hover { border-color: oklch(var(--p) / .45); box-shadow: 0 8px 24px oklch(var(--bc) / .08); }
  #services-page .services-access { overflow-wrap: anywhere; }
  #services-page a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  @media (max-width: 767px) {
    #services-page .services-art { max-width: 320px; }
  }
  @media (prefers-reduced-motion: reduce) {
    #services-page .services-card { transition: none; }
  }
</style>

<main id="services-page">
  <header class="services-hero relative isolate overflow-hidden border-b border-base-content/10 bg-base-200">
    <div class="hero-content relative mx-auto w-full max-w-7xl flex-col gap-4 px-5 py-10 md:flex-row md:gap-10 md:px-10 lg:py-12">
      <div class="services-hero-copy w-full text-center md:w-1/2 md:text-start">
        <h1 class="text-3xl font-bold lg:text-5xl">
          Services for
          <strong class="block text-primary">Redbrick members.</strong>
        </h1>
        <p class="mx-auto mt-4 max-w-lg leading-relaxed md:mx-0">
          Email, chat, game servers, web hosting, and more, hosted by Redbrick.
          Explore our services and find out how to use them.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4 md:justify-start">
          <a class="btn btn-primary" href="#catalogue">Browse services {{ arrow() }}</a>
          <a class="btn btn-neutral" href="#hosting">Services on request</a>
        </div>
      </div>
      <div class="services-art md:w-1/2" aria-hidden="true">
        <svg class="block h-auto w-full" viewBox="0 0 560 400" fill="none" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <filter id="services-paper-shadow" x="-30%" y="-30%" width="160%" height="180%" color-interpolation-filters="sRGB">
              <feDropShadow dx="0" dy="8" stdDeviation="7" flood-color="#0f172a" flood-opacity=".14"/>
            </filter>
            <filter id="services-logo-shadow" x="-30%" y="-30%" width="160%" height="180%" color-interpolation-filters="sRGB">
              <feDropShadow dx="0" dy="10" stdDeviation="7" flood-color="#0f172a" flood-opacity=".18"/>
            </filter>
          </defs>

          <!-- A loose collage of the things members use, like the homepage's floating graphics. -->
          <g transform="rotate(-7 134 88)" filter="url(#services-paper-shadow)">
            <rect x="36" y="30" width="196" height="120" rx="9" fill="oklch(var(--n))"/>
            <path d="M36 60h196" stroke="oklch(var(--nc) / .15)"/>
            <g fill="oklch(var(--nc) / .35)"><circle cx="51" cy="45" r="3"/><circle cx="63" cy="45" r="3"/><circle cx="75" cy="45" r="3"/></g>
            <text x="216" y="49" text-anchor="end" fill="oklch(var(--nc) / .8)" font-family="ui-monospace, monospace" font-size="11">ssh</text>
            <path d="m55 80 10 7-10 7" stroke="#fa7d83" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M79 88h49" stroke="oklch(var(--nc) / .85)" stroke-width="3" stroke-linecap="round"/>
            <path d="M55 108h76m-76 12h105" stroke="oklch(var(--nc) / .2)" stroke-width="3" stroke-linecap="round"/>
            <path d="M145 83v11" stroke="#fa7d83" stroke-width="3"/>
          </g>

          <g transform="rotate(10 436 92)" filter="url(#services-paper-shadow)" stroke-linejoin="round">
            <path d="m377 75 59-39 59 39v65H377V75Z" fill="oklch(var(--p) / .15)" stroke="oklch(var(--p) / .5)"/>
            <rect x="391" y="47" width="90" height="77" rx="5" fill="oklch(var(--b1))" stroke="oklch(var(--bc) / .2)"/>
